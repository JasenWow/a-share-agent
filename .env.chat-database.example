# ===== Server Configuration =====
SERVER_PORT=3001
SERVER_HOST=localhost

# ===== System Database (SQLite) =====
DATABASE_PATH=./data/chat-database.db

# ===== AI Provider Configuration =====
# Default AI provider: google | openai | anthropic | custom
AI_PROVIDER=google
# Default model ID (provider-specific)
AI_MODEL=gemini-2.5-flash

# --- Google ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Custom (OpenAI-compatible) ---
AI_API_KEY=
AI_BASE_URL=

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===== A-Share Agents Warehouse (read by future DuckDB adapter) =====
# Path to the DuckDB warehouse file produced by a-share-agents/scripts/etl/
# Relative to chat-database/ directory. Used by the DuckDB adapter (sub-project ❹).
WAREHOUSE_DUCKDB_PATH=../data/warehouse/meta.db
