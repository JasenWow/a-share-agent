# Tushare Pro API Token (required for tushare-server)
# Register at https://tushare.pro to get your token
TUSHARE_TOKEN=

# Data root directory (default: ./data)
DATA_ROOT=./data

# MCP Server ports (default values)
AKSHARE_PORT=8000
TUSHARE_PORT=8001
INTERNAL_STORE_PORT=8002
# QLIB_PORT=8003  # qlib-server is optional

# ===== Orchestrator / pi-runtime LLM =====
# Read by PiRuntimeOptions.resolvePiRuntimeOptions() so that the
# orchestrator entry point and bun test invocations pick them up.
#
# AQUAN_PROVIDER must be a Pi SDK builtin id. Common choices:
#   zai              GLM via ZAI (default; OpenAI-completions API)
#   minimax-cn       MiniMax via minimax.cn (Anthropic-messages API)
#   openai           OpenAI
#   anthropic        Anthropic
#   google           Google Gemini
AQUAN_PROVIDER=zai
AQUAN_MODEL=glm-4.5-air
AQUAN_API_KEY=
# Optional: override the provider's default base URL. Example for MiniMax CN:
# AQUAN_BASE_URL=https://api.minimaxi.com/anthropic/v1

# ===== Orchestrator server =====
ORCHESTRATOR_PORT=3010
