{
  "name": "aquan",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:all": "bash scripts/dev.sh start",
    "dev:stop": "bash scripts/dev.sh stop",
    "dev:status": "bash scripts/dev.sh status",
    "dev:server": "bun run --filter @aquan/server dev",
    "dev:web": "bun run --filter @aquan/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter @aquan/server db:generate",
    "db:migrate": "bun run --filter @aquan/server db:migrate",
    "db:seed": "bun run --filter @aquan/server db:seed",
    "db:studio": "bun run --filter @aquan/server db:studio",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:control-plane": "bun run --filter @aquan/orchestrator test:control-plane",
    "smoke:equity-daily-live": "bun run scripts/smoke/equity-daily-live.ts",
    "smoke:equity-daily-schedule-live": "bun run scripts/smoke/equity-daily-schedule-live.ts",
    "control-plane": "bun run packages/orchestrator/src/control-plane-server.ts",
    "orchestrator": "bun run scripts/orchestrator.ts",
    "orchestrator:stub": "bun run scripts/orchestrator.ts stub",
    "orchestrator:seed": "bun run scripts/orchestrator.ts seed",
    "dep-check": "depcruise --config .dependency-cruiser.cjs packages/*/src"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.4.3"
  }
}
